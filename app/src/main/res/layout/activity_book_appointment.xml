<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Randevu Al"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Kuaför Seçimi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kuaför Seçin:" />

        <Spinner
            android:id="@+id/spinnerBarbers"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:layout_marginVertical="8dp" />

        <!-- Hizmet Seçimi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hizmet Seçin:" />

        <Spinner
            android:id="@+id/spinnerServices"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:layout_marginVertical="8dp" />

        <!-- Çalışan Seçimi (İsteğe Bağlı) -->
        <LinearLayout
            android:id="@+id/layoutStaff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Çalışan Seçin (İsteğe Bağlı):" />

            <Spinner
                android:id="@+id/spinnerStaff"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:paddingVertical="8dp"
                android:layout_marginVertical="8dp" />
        </LinearLayout>

        <!-- Tarih Seçimi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tarih Seçin:" />

        <Spinner
            android:id="@+id/spinnerDateSelection"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:layout_marginVertical="8dp" />

        <!-- Saat Seçimi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saat Seçin:" />

        <Spinner
            android:id="@+id/spinnerTimeSelection"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:layout_marginVertical="8dp" />

        <Button
            android:id="@+id/buttonSaveAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Randevuyu Kaydet"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>